@page "/battle/{BattleId}"
@inject BattleSessionManager SessionManager
@inject NavigationManager Navigation
@inject SettingsService Settings

<div class="battle-detail-page">
    @if (battle != null)
    {
        <header class="battle-header">
            <div class="header-left">
                <button class="back-btn" @onclick="GoBack">← 戻る</button>
                <h2>@battle.GroupName</h2>
                <span class="battle-status @battle.Status.ToString().ToLower()">@battle.Status</span>
            </div>
            <div class="header-right">
                <span class="server-info">📡 @battle.ServerUrl</span>
            </div>
        </header>

        <div class="client-management">
            <div class="section-header">
                <h3>接続中のクライアント (@battle.ClientCount / 5)</h3>
                @if (battle.IsFull)
                {
                    <span class="full-indicator">✅ フル</span>
                }
            </div>

            <div class="connected-clients">
                @if (battle.Clients.Any())
                {
                    @foreach (var client in battle.Clients)
                    {
                        <div class="client-card">
                            <div class="client-header">
                                <span class="client-id">@client.ConnectionId[..8]</span>
                                <span class="connection-type @client.Type.ToString().ToLower()">@client.Type</span>
                                <button class="remove-btn" @onclick="() => RemoveClient(client)">×</button>
                            </div>
                            <div class="client-info">
                                <div>👤 @(client.PlayerId ?? "匿名")</div>
                                <div>🕒 @client.ConnectedAt.ToString("HH:mm:ss")</div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="no-clients">
                        <p>まだクライアントが接続されていません</p>
                        <p>下の+ボタンからクライアントを追加してください</p>
                    </div>
                }
            </div>

            <div class="add-client-buttons">
                <button class="add-client-btn signalr" @onclick="() => AddClient(ConnectionType.SignalR)" disabled="@battle.IsFull">
                    <div class="btn-icon">+</div>
                    <div class="btn-text">SignalR追加</div>
                    <div class="btn-subtitle">WebSocket</div>
                </button>

                <button class="add-client-btn magiconion" @onclick="() => AddClient(ConnectionType.MagicOnion)" disabled="@battle.IsFull">
                    <div class="btn-icon">+</div>
                    <div class="btn-text">MagicOnion追加</div>
                    <div class="btn-subtitle">gRPC-Web</div>
                </button>
            </div>
        </div>

        @if (battle.Clients.Any())
        {
            <div class="battle-fields">
                <h3>バトルフィールド</h3>
                <div class="fields-grid">
                    @foreach (var client in battle.Clients)
                    {
                        <div class="field-container">
                            <div class="field-header">
                                <span class="field-title">@client.ConnectionId[..8] (@client.Type)</span>
                                <span class="field-status">待機中</span>
                            </div>
                            <div class="battle-field" style="width: @(Settings.FieldSize)px; height: @(Settings.FieldSize)px;">
                                <div class="field-placeholder">
                                    <div class="placeholder-icon">🎮</div>
                                    <div class="placeholder-text">バトル待機中</div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <div class="error-message">
            <h2>バトルが見つかりません</h2>
            <p>指定されたバトル（ID: @BattleId）は存在しません。</p>
            <button class="btn-primary" @onclick="GoBack">ホームに戻る</button>
        </div>
    }
</div>

<style>
.battle-detail-page {
    padding: 20px;
    max-width: 1400px;
    margin: 0 auto;
}

.battle-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid #e0e0e0;
}

.header-left {
    display: flex;
    align-items: center;
    gap: 15px;
}

.back-btn {
    background: none;
    border: 1px solid #ddd;
    padding: 8px 12px;
    border-radius: 4px;
    cursor: pointer;
    color: #666;
    transition: all 0.2s;
}

.back-btn:hover {
    background-color: #f8f9fa;
    color: #333;
}

.battle-header h2 {
    margin: 0;
    color: #333;
    font-size: 1.8em;
}

.battle-status {
    padding: 6px 16px;
    border-radius: 20px;
    font-size: 0.85em;
    font-weight: 500;
    text-transform: uppercase;
}

.battle-status.waiting {
    background-color: #fff3cd;
    color: #856404;
}

.battle-status.inprogress {
    background-color: #d1ecf1;
    color: #0c5460;
}

.battle-status.completed {
    background-color: #d4edda;
    color: #155724;
}

.header-right {
    color: #666;
    font-size: 0.9em;
}

.client-management {
    background: white;
    border: 1px solid #ddd;
    border-radius: 8px;
    padding: 25px;
    margin-bottom: 30px;
}

.section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}

.section-header h3 {
    margin: 0;
    color: #333;
}

.full-indicator {
    color: #28a745;
    font-weight: 500;
}

.connected-clients {
    margin-bottom: 25px;
}

.client-card {
    background: #f8f9fa;
    border: 1px solid #dee2e6;
    border-radius: 6px;
    padding: 15px;
    margin-bottom: 10px;
}

.client-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
}

.client-id {
    font-family: 'Courier New', monospace;
    font-weight: 600;
    color: #333;
}

.connection-type {
    padding: 2px 8px;
    border-radius: 12px;
    font-size: 0.75em;
    font-weight: 500;
    text-transform: uppercase;
}

.connection-type.signalr {
    background-color: #cce5ff;
    color: #004085;
}

.connection-type.magiconion {
    background-color: #d4edda;
    color: #155724;
}

.remove-btn {
    background: none;
    border: none;
    color: #dc3545;
    cursor: pointer;
    font-size: 1.2em;
    padding: 0;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.remove-btn:hover {
    background-color: #ffe6e6;
    border-radius: 50%;
}

.client-info {
    display: flex;
    gap: 20px;
    font-size: 0.85em;
    color: #666;
}

.no-clients {
    text-align: center;
    padding: 40px 20px;
    color: #666;
    background: #f8f9fa;
    border: 2px dashed #ddd;
    border-radius: 8px;
}

.no-clients p:first-child {
    font-size: 1.1em;
    margin-bottom: 8px;
}

.no-clients p:last-child {
    font-size: 0.9em;
    margin-top: 8px;
}

.add-client-buttons {
    display: flex;
    gap: 20px;
    justify-content: center;
}

.add-client-btn {
    background: white;
    border: 2px solid #ddd;
    border-radius: 12px;
    padding: 20px;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    min-width: 140px;
    transition: all 0.2s;
}

.add-client-btn:not(:disabled):hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(0,0,0,0.1);
}

.add-client-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

.add-client-btn.signalr {
    border-color: #007bff;
    color: #007bff;
}

.add-client-btn.signalr:not(:disabled):hover {
    background-color: #e7f3ff;
}

.add-client-btn.magiconion {
    border-color: #28a745;
    color: #28a745;
}

.add-client-btn.magiconion:not(:disabled):hover {
    background-color: #e8f5e8;
}

.btn-icon {
    font-size: 2em;
    font-weight: 300;
}

.btn-text {
    font-weight: 600;
    font-size: 1em;
}

.btn-subtitle {
    font-size: 0.8em;
    opacity: 0.7;
}

.battle-fields {
    background: white;
    border: 1px solid #ddd;
    border-radius: 8px;
    padding: 25px;
}

.battle-fields h3 {
    margin: 0 0 20px 0;
    color: #333;
}

.fields-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 20px;
}

.field-container {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.field-header {
    text-align: center;
    margin-bottom: 8px;
}

.field-title {
    display: block;
    font-size: 0.85em;
    font-weight: 500;
    color: #333;
}

.field-status {
    display: block;
    font-size: 0.75em;
    color: #666;
    margin-top: 2px;
}

.battle-field {
    border: 1px solid #ccc;
    background: #f5f5f5;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
}

.field-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    opacity: 0.6;
}

.placeholder-icon {
    font-size: 2em;
}

.placeholder-text {
    font-size: 0.8em;
    text-align: center;
}

.error-message {
    text-align: center;
    padding: 60px 20px;
    color: #666;
}

.error-message h2 {
    color: #dc3545;
    margin-bottom: 15px;
}

.btn-primary {
    background-color: #007bff;
    color: white;
    border: none;
    padding: 12px 24px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 1em;
    transition: background-color 0.2s;
}

.btn-primary:hover {
    background-color: #0056b3;
}
</style>

@code {
    [Parameter] public string BattleId { get; set; } = string.Empty;

    private Battle? battle;

    protected override void OnInitialized()
    {
        battle = SessionManager.GetBattle(BattleId);
    }

    private void AddClient(ConnectionType type)
    {
        if (battle != null && !battle.IsFull)
        {
            var client = new BattleClient
            {
                ConnectionId = $"client-{Random.Shared.Next(1000, 9999):D4}",
                Type = type,
                PlayerId = $"player-{Random.Shared.Next(100, 999):D3}",
                ConnectedAt = DateTime.Now
            };

            battle.Clients.Add(client);

            // 5クライアント揃ったらバトル開始状態に変更
            if (battle.IsFull)
            {
                battle.Status = BattleStatus.InProgress;
            }

            StateHasChanged();
        }
    }

    private void RemoveClient(BattleClient client)
    {
        if (battle != null)
        {
            battle.Clients.Remove(client);
            // クライアントが減ったら待機状態に戻す
            if (battle.Status == BattleStatus.InProgress && !battle.IsFull)
            {
                battle.Status = BattleStatus.Waiting;
            }
            StateHasChanged();
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/");
    }
}
