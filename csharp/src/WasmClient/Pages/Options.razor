.save-message {
    background-color: #d4edda;
    color: #155724;
    padding: 12px 16px;
    border-radius: 6px;
    margin-top: 15px;
    text-align: center;
    font-weight: 500;
}

.clear-message {
    background-color: #d4edda;
    color: #155724;
    padding: 12px 16px;
    border-radius: 6px;
    margin-top: 15px;
    text-align: center;
    font-weight: 500;
