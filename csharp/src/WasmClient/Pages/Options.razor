}

.stat-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.stat-label {
    font-size: 0.9em;
    color: #666;
}

.stat-value {
    font-weight: 600;
    color: #333;
}

.danger-zone {
    background: #fff5f5;
    border: 1px solid #feb2b2;
    border-radius: 6px;
    padding: 20px;
    margin-top: 10px;
}

.danger-zone h4 {
    margin: 0 0 10px 0;
    color: #c53030;
    font-size: 1em;
}

.danger-zone p {
    margin: 0 0 15px 0;
    color: #744210;
    font-size: 0.9em;
}

.danger-actions {
    display: flex;
    gap: 10px;
}

.btn-danger {
    background-color: #dc3545;
    color: white;
    border: none;
    padding: 10px 16px;
    border-radius: 4px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    transition: all 0.2s;
}

.btn-danger:hover:not(:disabled) {
    background-color: #c82333;
    transform: translateY(-1px);
}

.btn-danger:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
}

.dialog-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0,0,0,0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
}

.dialog {
    background: white;
    border-radius: 8px;
    width: 500px;
    max-width: 90vw;
    box-shadow: 0 8px 32px rgba(0,0,0,0.2);
    max-height: 90vh;
    overflow-y: auto;
}

.dialog-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px;
    border-bottom: 1px solid #eee;
}

.dialog-header h3 {
    margin: 0;
    color: #c53030;
}

.close-btn {
    background: none;
    border: none;
    font-size: 1.5em;
    cursor: pointer;
    color: #999;
    padding: 0;
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
}

.close-btn:hover {
    background-color: #f5f5f5;
    color: #666;
}

.dialog-body {
    padding: 20px;
    color: #333;
}

.dialog-body p {
    margin-bottom: 15px;
}

.dialog-body ul {
    margin: 15px 0;
    padding-left: 20px;
}

.dialog-body li {
    margin-bottom: 5px;
}

.dialog-footer {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    padding: 20px;
    border-top: 1px solid #eee;
    background-color: #f8f9fa;
}

.info-section {
    background: white;
    border: 1px solid #ddd;
    border-radius: 8px;
    padding: 25px;
}

.info-section h3 {
    margin: 0 0 20px 0;
    color: #333;
    font-size: 1.2em;
}

.info-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
}

.info-item {
    display: flex;
    justify-content: space-between;
    padding: 8px 0;
    border-bottom: 1px solid #f8f9fa;
}

.info-item:last-child {
    border-bottom: none;
}

.info-item strong {
    color: #333;
}

.info-item span {
    color: #666;
}
</style>

@code {
    private bool showSaveMessage = false;
    private bool showClearMessage = false;
    private bool showClearConfirmDialog = false;
    private bool isClearing = false;
    private BattleHistoryStats battleHistoryStats = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadBattleHistoryStats();
    }

    private async Task LoadBattleHistoryStats()
    {
        try
        {
            battleHistoryStats = await HistoryService.GetStorageStatsAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to load battle history stats: {ex.Message}");
            battleHistoryStats = new BattleHistoryStats();
        }
    }

    private async Task SaveSettings()
    {
        await Settings.SaveAsync();
        showSaveMessage = true;

        // 3秒後にメッセージを非表示にする
        _ = Task.Delay(3000).ContinueWith(_ =>
        {
            showSaveMessage = false;
            InvokeAsync(StateHasChanged);
        });
    }

    private async Task ResetSettings()
    {
        Settings.Reset();
        await Settings.SaveAsync();
        StateHasChanged();
    }

    private async Task TestConnections()
    {
        // 将来実装: サーバー接続テスト
        await Task.CompletedTask;
    }

    private void ShowClearConfirmDialog()
    {
        showClearConfirmDialog = true;
    }

    private void HideClearConfirmDialog()
    {
        showClearConfirmDialog = false;
    }

    private async Task ClearAllBattleHistory()
    {
        if (isClearing) return;

        isClearing = true;
        try
        {
            await HistoryService.ClearAllBattleHistoryAsync();
            await LoadBattleHistoryStats(); // 統計情報を更新

            showClearConfirmDialog = false;
            showClearMessage = true;

            // 3秒後にメッセージを非表示にする
            _ = Task.Delay(3000).ContinueWith(_ =>
            {
                showClearMessage = false;
                InvokeAsync(StateHasChanged);
            });
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to clear battle history: {ex.Message}");
            // TODO: Show error message to user
        }
        finally
        {
            isClearing = false;
            StateHasChanged();
        }
    }

    private string FormatDataSize(long bytes)
    {
        if (bytes < 1024)
            return $"{bytes} B";
        else if (bytes < 1024 * 1024)
            return $"{bytes / 1024.0:F1} KB";
        else
            return $"{bytes / (1024.0 * 1024.0):F1} MB";
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/");
    }
}
