{
  "ServiceDiscovery": {
    "Server": {
      "SignalRPort": 5010,
      "MagicOnionPort": 5011,
      "HealthCheckPort": 5012,
      "AllowedOrigins": [
        "*"
      ]
    },
    "Session": {
      "DefaultMaxPlayers": 5,
      "SessionTimeoutMinutes": 30,
      "CleanupIntervalMinutes": 2,
      "MaxConcurrentSessions": 100
    },
    "BattleServer": {
      "HeartbeatIntervalSeconds": 15,
      "HealthCheckTimeoutSeconds": 5,
      "UnhealthyThresholdCount": 2,
      "RemoveUnhealthyAfterMinutes": 2
    },
    "GameLift": {
      "Mode": "Disabled",
      "Anywhere": {
        "FleetId": "",
        "CustomLocation": "",
        "Region": "ap-northeast-1",
        "MaxGameSessionsPerFleet": 50
      },
      "AWS": {
        "Profile": "",
        "Region": "ap-northeast-1"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "ServiceDiscoveryServer": "Trace",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.Extensions": "Information"
    }
  },
  "AllowedHosts": "*"
}
