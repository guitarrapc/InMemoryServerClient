{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning",
      "MagicOnion": "Debug",
      "InMemoryServer.GameLift": "Debug",
      "Amazon.GameLift": "Debug"
    },
    "Kestrel": {
