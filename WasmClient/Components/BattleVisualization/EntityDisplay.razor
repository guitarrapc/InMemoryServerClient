@page "/entity-display"

@using WasmClient.Models
@using WasmClient.Constants

<div class="entity-display" style="position: absolute; left: @(Entity.Position.X * scale)px; top: @(Entity.Position.Y * scale)px;">
    <div class="entity-info">
        <h4>@Entity.Type</h4>
        <p>Health: @Entity.Health / @Entity.MaxHealth</p>
        <p>Position: (@Entity.Position.X, @Entity.Position.Y)</p>
    </div>
</div>

@code {
    [Parameter] public EntityData Entity { get; set; } = null!;
    private double scale = 10; // Scale factor for positioning
}