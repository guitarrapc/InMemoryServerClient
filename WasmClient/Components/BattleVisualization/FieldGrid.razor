@page "/field-grid"
@using WasmClient.Models
@using WasmClient.Services
@inject FieldVisualizationService FieldVisualizationService

<div class="field-grid">
    @if (FieldData != null)
    {
        @for (int y = 0; y < FieldData.Height; y++)
        {
            <div class="grid-row">
                @for (int x = 0; x < FieldData.Width; x++)
                {
                    var entity = FieldData.Entities.FirstOrDefault(e => e.Position.X == x && e.Position.Y == y);
                    <div class="grid-cell @(entity != null ? entity.Type.ToString().ToLower() : "empty")">
                        @if (entity != null)
                        {
                            <EntityRenderer Entity="entity" />
                        }
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter] public BattleFieldData FieldData { get; set; } = new BattleFieldData();

    protected override void OnInitialized()
    {
        FieldVisualizationService.OnFieldUpdated += UpdateField;
    }

    private void UpdateField(BattleFieldData updatedFieldData)
    {
        FieldData = updatedFieldData;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        FieldVisualizationService.OnFieldUpdated -= UpdateField;
    }
}